# ==============================================================================
# CyberShield Mesh — Environment Configuration
# Copy this file to `.env` and set your Gemini API key & Google OAuth client.
# ==============================================================================

# Required: Google AI Studio / Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Required for Sign in with Google & Gmail Security Alerts:
# Create an OAuth 2.0 Client ID (Web Application) in Google Cloud Console with
# Authorized Redirect URI: http://127.0.0.1:8000/auth/google/callback
# and enable the Gmail API.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Optional parallel mobile push notification topic via ntfy.sh
NTFY_TOPIC=cybershield-mesh-alerts-2026

# Comma-separated remote TCP ports monitored for suspicious outbound traffic
WATCH_PORTS=4444,1337,9001,5555

# Optional target IP used by demo_attack/sim_intrusion.py
DEMO_TARGET_IP=10.100.5.67

# FastAPI bind host & port
HOST=127.0.0.1
PORT=8000
