# ==============================================================================
# CyberShield Mesh — Environment Configuration
# Copy this file to `.env` and fill in your Google Gemini API key & ntfy topic.
# ==============================================================================

# Required: Google AI Studio / Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for sub-second autonomous defense & interactive chat
GEMINI_MODEL=gemini-3.5-flash-lite

# ntfy.sh mobile push notification topic (subscribe to this topic in the ntfy app)
NTFY_TOPIC=cybershield-mesh-alerts-2026

# Comma-separated remote TCP ports that trigger instant inspection
WATCH_PORTS=4444,1337,9001,5555

# Attacker PC IP used for the live two-PC demo & safe Simulate Attack button
DEMO_TARGET_IP=10.100.5.67

# Optional FastAPI bind host & port (matched by electron/main.js)
HOST=127.0.0.1
PORT=8000
